PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aiparkingslot?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ========================================================
# AI ParkSlot Real AI Assistant Configuration
# ========================================================
# Default Provider: Google Gemini (Recommended)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash
AI_BACKUP_MODEL=gemini-flash-lite-latest

# Optional: Alternative OpenAI-Compatible Provider (e.g. OpenAI, Groq, Ollama)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
